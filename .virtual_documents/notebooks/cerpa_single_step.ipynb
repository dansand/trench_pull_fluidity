           "first isostatic\ncolumn (" + r"$x_I$" + ")\n" + r"$dV/dx = 0$",                                                                                                                          
           fontsize=12)  

# --- Bottom: ΔF_D - ΔGPE* + F_B ---
ax2.plot(xkm, FB         * 1e-12, color="red", lw=2,
