Szz = np.trapz(-p + tzz, z, axis=0)     # int sigma_zz dz   (= -GPE*)

#delta_Fd  = Fd  - Fd[tindx]
#delta_Szz = Szz - Szz[tindx]            # = -Delta GPE*  (we plot this directly)

# Trench-reference window: average ±N km around the picked trench column.                                                                                                                            
